{
  "name": "agentrelay",
  "version": "0.1.0",
  "description": "A continuity layer for coding agents",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "migrate:up": "node-pg-migrate --envPath .env up",
    "migrate:down": "node-pg-migrate --envPath .env down",
    "migrate:create": "node-pg-migrate --envPath .env create",
    "db:verify": "tsx scripts/verify-schema.ts",
    "test:memory": "tsx scripts/test-memory-store.ts",
    "test:lifecycle": "tsx scripts/test-lifecycle.ts",
    "test:reliability": "tsx scripts/test-memory-reliability.ts",
    "test:retrieval": "tsx scripts/test-retrieval.ts",
    "test:compiler": "tsx scripts/test-context-compiler.ts",
    "test": "tsx scripts/verify-schema.ts && tsx scripts/test-memory-store.ts && tsx scripts/test-lifecycle.ts && tsx scripts/test-memory-reliability.ts && tsx scripts/test-retrieval.ts && tsx scripts/test-context-compiler.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "js-tiktoken": "^1.0.21",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
